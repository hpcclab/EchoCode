# 🚀 Ignore Node.js dependencies (everyone should run `npm install`)
node_modules/

# 🚀 Ignore local VS Code workspace settings (everyone has their own)
.vscode/

# 🚀 Ignore compiled VSIX package files (should be built, not committed)
*.vsix

# 🚀 Ignore VS Code test environment files
.vscode-test/

# 🚀 Ignore package lock files (optional, but ensures dependency flexibility)
package-lock.json

# 🚀 Ignore source map files (generated automatically)
**/*.map

# 🚀 Ignore linting & ESLint cache
**/eslint.config.mjs

# 🚀 Ignore OS-specific system files
.DS_Store
Thumbs.db

# Morgan is using this file for reference
*-messy.js

# Coverage artifacts
.nyc_output/
coverage/

# Logs and temporary files
*.log
*.tmp
# Ignore environment variable files
.env

# Ignore venv folders for Python virtual environments
echocode-venv/

TestFile1.cpp
# Generated per-machine on activation from the user's own installed
# VS Code commands (see buildExternalCommandRegistry). Regenerates if
# absent, so it must never be committed.
Core/program_settings/program_settings/external_commands.json
wiki/.obsidian/app.json
wiki/.obsidian/appearance.json
wiki/.obsidian/core-plugins.json
wiki/.obsidian/workspace.json

# Feature diagrams: the rendered SVGs are tracked, because the wiki pages embed them
# and they must resolve in a fresh clone. The .drawio sources and the generators that
# produce both are local-only:
#   node wiki/diagrams/generate.js && python3 wiki/diagrams/render_svg.py
#
# Note the shape of these rules. Excluding "wiki/diagrams/" outright would make the
# negations below impossible — git cannot re-include a file whose parent directory is
# excluded — so the contents are excluded and svg/ is re-included instead.
wiki/diagrams/*
!wiki/diagrams/svg/
wiki/diagrams/svg/*
!wiki/diagrams/svg/*.svg
