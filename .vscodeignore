# 🚀 node_modules is intentionally NOT ignored here.
# vsce's default packaging resolves node_modules against "dependencies" in
# package.json and prunes devDependencies automatically; excluding the whole
# folder would strip out runtime deps (mammoth, pdf-parse, dotenv, say,
# sound-play, ffmpeg-static, fluent-ffmpeg) and break the extension for
# anyone installing it from the Marketplace.

# 🚀 Ignore Git metadata
.git/
.gitignore

# 🚀 Ignore VSIX build artifacts
*.vsix

# 🚀 Ignore test-related files
.vscode-test/
.vscode-test.mjs
test/

# 🚀 Ignore the TS command-registry scaffold used only by the test suite
# (the real entry point is extension.js at the repo root; nothing at
# runtime requires src/ or its compiled out/ output).
src/
out/
tsconfig.json

# 🚀 Ignore CI/CD and repo scaffolding not needed by an installed extension
.github/
vsc-extension-quickstart.md

# 🚀 Ignore temporary or cache files
**/*.map
**/.vscode-test.*

# 🚀 Ignore unnecessary config files
**/jsconfig.json
**/eslint.config.mjs
